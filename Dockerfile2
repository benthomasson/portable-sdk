        autoconf automake libtool curl perl nodejs \
        python3 openssl-dev \
        libc6-compat \
        gcompat libstdc++ \
        ;

WORKDIR /data/git/python-wasm-sdk
COPY . .
COPY . /opt/python-wasm-sdk
WORKDIR /opt/python-wasm-sdk
