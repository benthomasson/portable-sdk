RUN apt-get update && \
    apt-get install --no-install-suggests --no-install-recommends --yes \
    python3-venv gcc libpython3-dev iputils-ping libcap2 libunistring2 libidn2-0 libnettle6 \
    git xz-utils wget libffi-dev tar file lz4 git patch bison flex findutils binutils coreutils \
    libbz2-dev libncursesw5-dev libgdbm-dev liblzma-dev libsqlite3-dev tk-dev uuid-dev libreadline-dev \
    clang libssl-dev curl


WORKDIR /data/git/python-wasm-sdk
COPY . .
COPY . /opt/python-wasm-sdk
WORKDIR /opt/python-wasm-sdk
